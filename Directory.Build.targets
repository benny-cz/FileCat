<Project>
  <!--
    FileCat builds make no network calls. Avalonia.BuildServices (MIT, build-time only) runs an
    "AvaloniaStats" task before compilation that reports usage statistics; this empty target
    replaces it. Nothing from that package is shipped in FileCat.
  -->
  <Target Name="AvaloniaStats" />

  <!-- The HTML page view uses WebView2's Core API only (D-51): the package's WinForms and WPF wrappers, which its build
       targets reference in every .NET project, are left out. -->
  <Target Name="DropWebView2Wrappers" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf' Or '%(Filename)' == 'Microsoft.Web.WebView2.WinForms'" />
    </ItemGroup>
  </Target>

  <!--
    global.json selects SDK 10.0.101, whose bundled packs are .NET 10.0.1. Self-contained packages, apphosts and
    ReadyToRun code instead use the serviced runtime below (restore downloads its packs), so a package never ships
    a ten-month-old runtime. Framework-dependent builds still roll forward at run time.

    This is the runtime pack whose license texts are pinned and reviewed in licenses/dependencies/index.json, which
    the publish step enforces. Raising it means regenerating and reviewing that snapshot for every RID first; the
    reviewed snapshot is updated only after all five official packages, signatures and exact notice bytes agree.
  -->
  <PropertyGroup>
    <FileCatServicedRuntimeVersion>10.0.14</FileCatServicedRuntimeVersion>
  </PropertyGroup>
  <Target Name="FileCatUseServicedRuntimePacks" BeforeTargets="ProcessFrameworkReferences">
    <ItemGroup>
      <KnownFrameworkReference Condition="'%(Identity)' == 'Microsoft.NETCore.App' and '%(TargetFramework)' == 'net10.0'">
        <LatestRuntimeFrameworkVersion>$(FileCatServicedRuntimeVersion)</LatestRuntimeFrameworkVersion>
      </KnownFrameworkReference>
      <KnownAppHostPack Condition="'%(Identity)' == 'Microsoft.NETCore.App' and '%(TargetFramework)' == 'net10.0'">
        <AppHostPackVersion>$(FileCatServicedRuntimeVersion)</AppHostPackVersion>
      </KnownAppHostPack>
      <KnownCrossgen2Pack Condition="'%(Identity)' == 'Microsoft.NETCore.App.Crossgen2' and '%(TargetFramework)' == 'net10.0'">
        <Crossgen2PackVersion>$(FileCatServicedRuntimeVersion)</Crossgen2PackVersion>
      </KnownCrossgen2Pack>
    </ItemGroup>
  </Target>

  <Target Name="FileCatRequireDependencyLock" BeforeTargets="_GenerateRestoreGraphProjectEntry"
          Condition="'$(RestorePackagesWithLockFile)' == 'true' and '$(FileCatUpdateDependencyLocks)' != 'true' and '$(MSBuildProjectExtension)' == '.csproj'">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/packages.lock.json')"
           Text="FileCat dependency lock is missing. Regeneration requires explicit FileCatUpdateDependencyLocks=true and review of the resulting lock changes." />
  </Target>
</Project>
