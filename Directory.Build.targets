<Project>
  <!--
    FileCat builds make no network calls. Avalonia.BuildServices (MIT, build-time only) runs an
    "AvaloniaStats" task before compilation that reports usage statistics; this empty target
    replaces it. Nothing from that package is shipped in FileCat.
  -->
  <Target Name="AvaloniaStats" />

  <!-- The HTML page view uses WebView2's Core API only (D-51): the package's WinForms and WPF wrappers, which its build
       targets reference in every .NET project, are left out. -->
  <Target Name="DropWebView2Wrappers" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf' Or '%(Filename)' == 'Microsoft.Web.WebView2.WinForms'" />
    </ItemGroup>
  </Target>

  <Target Name="FileCatRequireDependencyLock" BeforeTargets="_GenerateRestoreGraphProjectEntry"
          Condition="'$(RestorePackagesWithLockFile)' == 'true' and '$(FileCatUpdateDependencyLocks)' != 'true' and '$(MSBuildProjectExtension)' == '.csproj'">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/packages.lock.json')"
           Text="FileCat dependency lock is missing. Regeneration requires explicit FileCatUpdateDependencyLocks=true and review of the resulting lock changes." />
  </Target>
</Project>
