<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- DescendantFocusAutomationTests drive the IRootProvider contract that native screen-reader bridges use. -->
    <AvaloniaAccessUnstablePrivateApis>true</AvaloniaAccessUnstablePrivateApis>
    <NoWarn>$(NoWarn);AVA3001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\FileCat.App\FileCat.App.csproj" />
    <ProjectReference Include="..\FileCat.CoreCrashHarness\FileCat.CoreCrashHarness.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\FileCat.WorkerProbe\FileCat.WorkerProbe.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\LiveUsbGuard.cs" Link="LiveUsbGuard.cs" />
    <Compile Include="..\ArchivePasswordReadFixture.cs" Link="ArchivePasswordReadFixture.cs" />
    <Compile Include="..\ArchiveEditDiscardCases.cs" Link="ArchiveEditDiscardCases.cs" />
    <Compile Include="..\TestCleanup.cs" Link="TestCleanup.cs" />
    <Compile Include="..\TemporaryLinkFixture.cs" Link="TemporaryLinkFixture.cs" />
    <Compile Include="..\ProcessAuthorityScopes.cs" Link="ProcessAuthorityScopes.cs" />
    <Compile Include="..\SettledJournals.cs" Link="SettledJournals.cs" />
    <!-- The in-memory SFTP server of the remote tests, for UI tests of connecting and browsing. -->
    <Compile Include="..\FileCat.Remote.Tests\FakeSftp.cs" Link="Sftp\FakeSftp.cs" />
    <Compile Include="..\FileCat.Remote.Tests\TestSshd.cs" Link="Sftp\TestSshd.cs" />
    <!-- A disk image with deleted files, for the recovery UI (see the Core tests' TestData/Recovery/README.md). -->
    <None Include="..\FileCat.Core.Tests\TestData\Recovery\fat16.img.gz" Link="TestData\fat16.img.gz" CopyToOutputDirectory="PreserveNewest" />
    <None Include="TestData\Viewer\owned-two-page.pdf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="TestData\Viewer\owned-encrypted.pdf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="TestData\Viewer\owned-one-page.pdf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!--
    The administrator launcher tests (I644) start the real FileCat.AdminLauncher.exe, which reaches this project's output
    beside FileCat.exe through the application, with a windowless stand-in for FileCat.exe that records what it received.
    The stand-in is compiled as the launcher is (eng/Build-PrivilegedBootstrap.ps1, Visual Studio C++ tools), on Windows.
  -->
  <PropertyGroup>
    <FileCatLauncherStandInRuntime Condition="'$(RuntimeIdentifier)' == 'win-x64' or '$(RuntimeIdentifier)' == 'win-arm64'">$(RuntimeIdentifier)</FileCatLauncherStandInRuntime>
    <FileCatLauncherStandInRuntime Condition="'$(RuntimeIdentifier)' == '' and '$(OS)' == 'Windows_NT' and '$(NETCoreSdkRuntimeIdentifier)' == 'win-arm64'">win-arm64</FileCatLauncherStandInRuntime>
    <FileCatLauncherStandInRuntime Condition="'$(RuntimeIdentifier)' == '' and '$(OS)' == 'Windows_NT' and '$(FileCatLauncherStandInRuntime)' == ''">win-x64</FileCatLauncherStandInRuntime>
    <FileCatBuildLauncherStandIn Condition="'$(FileCatLauncherStandInRuntime)' != '' and '$(OS)' == 'Windows_NT' and '$(FileCatBuildAdministratorLauncher)' != 'false'">true</FileCatBuildLauncherStandIn>
  </PropertyGroup>
  <ItemGroup Condition="'$(FileCatBuildLauncherStandIn)' == 'true'">
    <None Include="$(IntermediateOutputPath)administrator-launcher-stand-in\AdministratorLauncherStandIn.exe" Link="AdministratorLauncher\AdministratorLauncherStandIn.exe"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <Target Name="FileCatCompileLauncherStandIn" AfterTargets="CoreCompile" Condition="'$(FileCatBuildLauncherStandIn)' == 'true' and '$(DesignTimeBuild)' != 'true'"
          Inputs="AdministratorLauncher\AdministratorLauncherStandIn.cpp;AdministratorLauncher\AdministratorLauncherStandIn.manifest;..\..\eng\Build-PrivilegedBootstrap.ps1;$(MSBuildProjectFullPath)"
          Outputs="$(IntermediateOutputPath)administrator-launcher-stand-in\AdministratorLauncherStandIn.exe">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\eng\Build-PrivilegedBootstrap.ps1&quot; -Component AdministratorLauncherStandIn -ProjectDirectory &quot;$(MSBuildProjectDirectory)\AdministratorLauncher&quot; -OutputFile &quot;$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'administrator-launcher-stand-in', 'AdministratorLauncherStandIn.exe'))&quot; -IntermediateDirectory &quot;$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'administrator-launcher-stand-in'))&quot; -Runtime &quot;$(FileCatLauncherStandInRuntime)&quot;" />
    <ItemGroup>
      <FileWrites Include="$(IntermediateOutputPath)administrator-launcher-stand-in\**" />
    </ItemGroup>
  </Target>
</Project>
