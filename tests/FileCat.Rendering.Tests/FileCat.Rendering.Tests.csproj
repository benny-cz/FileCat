  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\FileCat.App\FileCat.App.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
