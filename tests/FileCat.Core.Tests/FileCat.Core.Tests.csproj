<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- Windows' own LZNT1 compressor is called as the reference for FileCat's NTFS decompression. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Upstream SharpCompress, test-only and under its own alias: its RAR reader (ported from UnRAR, which FileCat does not
         ship) is the differential oracle for FileCat's RAR reader, and its 7z reader one for FileCat's 7z PPMd. Unaliased
         SharpCompress types are FileCat's own build (src/ThirdParty/SharpCompress). -->
    <PackageReference Include="SharpCompress" Aliases="UpstreamSharpCompress" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\FileCat.Core\FileCat.Core.csproj" />
    <ProjectReference Include="..\..\src\FileCat.Archives\FileCat.Archives.csproj" />
    <ProjectReference Include="..\..\src\FileCat.Recovery\FileCat.Recovery.csproj" />
    <ProjectReference Include="..\FileCat.CoreCrashHarness\FileCat.CoreCrashHarness.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <!-- Sample archives from SharpCompress's test suite (MIT); see TestData/Archives/README.md. Disk images made by
         eng/make-recovery-fixtures.sh; see TestData/Recovery/README.md. -->
    <None Include="TestData\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\TestCleanup.cs" Link="TestCleanup.cs" />
  </ItemGroup>
</Project>
