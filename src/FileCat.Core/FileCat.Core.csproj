<Project Sdk="Microsoft.NET.Sdk">
  <!-- Portable core: no Avalonia, no native parser packages (plan §19.4). -->
  <PropertyGroup>
    <RootNamespace>FileCat.Core</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The dedicated macOS VM worker consumes this portable library with the musl ARM64 runtime. -->
    <RuntimeIdentifiers>$(RuntimeIdentifiers);linux-musl-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="FileCat.Core.Tests" />
    <InternalsVisibleTo Include="FileCat.Rendering.Tests" />
    <!-- Share observed-memory accounting with the two builds of the stream-only archive rewrite engine. -->
    <InternalsVisibleTo Include="FileCat.Archives" />
    <InternalsVisibleTo Include="FileCat.Archives.Writing" />
    <InternalsVisibleTo Include="FileCat.CoreCrashHarness" />
    <!-- Test tooling: FZ10 drives the internal Unix archive job route (eng/validation/archive-writing). -->
    <InternalsVisibleTo Include="FileCat.ArchiveFuzzHarness" />
    <InternalsVisibleTo Include="FileCat.WorkerProbe" />
    <InternalsVisibleTo Include="FileCat.ArchiveQualificationHost" />
    <InternalsVisibleTo Include="FileCat.ArchiveReleaseManifest" />
    <InternalsVisibleTo Include="FileCat.ArchiveWorker" />
    <InternalsVisibleTo Include="FileCat.ArchiveVmProbe" />
    <InternalsVisibleTo Include="FileCat.App.Tests" />
    <InternalsVisibleTo Include="FileCat" />
    <InternalsVisibleTo Include="FileCat.Platform.Windows" />
    <InternalsVisibleTo Include="FileCat.Platform.Windows.Tests" />
    <InternalsVisibleTo Include="FileCat.Remote" />
    <InternalsVisibleTo Include="FileCat.Remote.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- minisign signatures (D-57): Ed25519 and BLAKE2b, managed code. -->
    <PackageReference Include="BouncyCastle.Cryptography" />
  </ItemGroup>
</Project>
