<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fc="using:FileCat.App.Controls">
  <!-- All colors come from semantic Fc* tokens supplied by ThemeManager (plan §18.2). -->

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource FcWindow}" />
    <Setter Property="Foreground" Value="{DynamicResource FcText}" />
    <Setter Property="FontFamily" Value="{DynamicResource FcFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FcUiFontSize}" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource FcPanel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FcBorder}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <!-- Where F5 and F6 go: the target's frame is in the target color (the active panel's is thicker, in the active color) -->
  <Style Selector="Border.panel.target">
    <Setter Property="BorderBrush" Value="{DynamicResource FcTargetAccent}" />
  </Style>
  <Style Selector="Border.panel.active">
    <Setter Property="BorderBrush" Value="{DynamicResource FcActiveAccent}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource FcTextMuted}" />
  </Style>
  <!-- Fluent draws a TextBox placeholder at half opacity: about 2:1 in every palette (the permission editors' "S-1-…"
       hint). Its brush already reads as a hint at full opacity. The template sets that opacity, which outranks a plain
       style; a pseudo-class selector applies at trigger priority, which outranks it. -->
  <Style Selector="TextBox:not(:disabled) /template/ TextBlock#PART_Placeholder">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="TextBlock.small">
    <Setter Property="FontSize" Value="{DynamicResource FcSmallFontSize}" />
  </Style>

  <!-- Tab strip -->
  <Style Selector="Button.tab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource FcTextMuted}" />
    <Setter Property="Padding" Value="{DynamicResource FcTabPadding}" />
    <Setter Property="Margin" Value="0,0,1,0" />
    <Setter Property="CornerRadius" Value="4,4,0,0" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="MinHeight" Value="{DynamicResource FcTabHeight}" />
    <Setter Property="Focusable" Value="False" />
  </Style>
  <Style Selector="Button.tab.current">
    <Setter Property="Background" Value="{DynamicResource FcPanel}" />
    <Setter Property="Foreground" Value="{DynamicResource FcText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FcActiveAccent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.flat">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Focusable" Value="False" />
  </Style>

  <!-- Path box: reads like a label until focused -->
  <Style Selector="TextBox.path">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="MinHeight" Value="{DynamicResource FcInputHeight}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <!-- The filter box, and while it filters: in the accent color, so a filtered panel is not taken for a whole folder. -->
  <Style Selector="TextBox.filter">
    <Setter Property="Foreground" Value="{DynamicResource FcTextMuted}" />
    <Setter Property="HorizontalContentAlignment" Value="Right" />
  </Style>
  <Style Selector="TextBox.filter.active">
    <Setter Property="Foreground" Value="{DynamicResource FcActiveAccent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- While the path shows as links, the box beneath keeps its text to itself (translucent themes would show it). -->
  <Style Selector="TextBox.path.linked /template/ TextPresenter#PART_TextPresenter">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="TextBox.path:focus">
    <Setter Property="Background" Value="{DynamicResource FcCard}" />
  </Style>
  <Style Selector="GridSplitter.panelResize:focus">
    <Setter Property="Background" Value="{DynamicResource FcFocusBorder}" />
  </Style>
  <Style Selector="GridSplitter.panelResize.resizeActive">
    <Setter Property="Background" Value="{DynamicResource FcFocusBorder}" />
  </Style>
  <Style Selector="TextBox.path:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource FcFocusBorder}" />
    <Setter Property="Background" Value="{DynamicResource FcCard}" />
  </Style>
  <Style Selector="TextBox.path /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- Where a dragged panel would go: the focus color, or the error color when there is no room -->
  <Style Selector="Border.dockPreview">
    <Setter Property="Background" Value="{DynamicResource FcFocusBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FcFocusBorder}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Opacity" Value="0.85" />
  </Style>
  <Style Selector="Border.dockPreview.refused">
    <Setter Property="BorderBrush" Value="{DynamicResource FcError}" />
  </Style>
  <Style Selector="TextBlock.dockPreview">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource FcFocusText}" />
  </Style>

  <!-- Command search in the menu bar: a field on the menu's glass, outlined in the focus color while typing -->
  <Style Selector="TextBox.commandSearch">
    <Setter Property="MinHeight" Value="{DynamicResource FcInputHeight}" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.commandSearch /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource FcCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FcBorder}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TextBox.commandSearch:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource FcFocusBorder}" />
  </Style>

  <!-- Find fields keep a visible result cue after the debounced search finishes. -->
  <Style Selector="TextBox.searchPending /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource FcBorder}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TextBox.searchPending:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource FcTextMuted}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="TextBox.searchFound /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource FcSuccess}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="TextBox.searchMissing /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource FcError}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- Role chips (non-color cue: text): TARGET, "Set as target" on the other panels, the active panel's own target -->
  <Style Selector="Button.role">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="Margin" Value="4,2" />
    <Setter Property="MinHeight" Value="{DynamicResource FcRoleHeight}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="FontSize" Value="{DynamicResource FcRoleFontSize}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource FcBorder}" />
    <Setter Property="Foreground" Value="{DynamicResource FcTextMuted}" />
  </Style>
  <Style Selector="Button.role:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource FcTargetAccent}" />
    <Setter Property="Foreground" Value="{DynamicResource FcText}" />
  </Style>
  <Style Selector="Button.role.target">
    <Setter Property="Background" Value="{DynamicResource FcTargetFill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FcTargetAccent}" />
    <Setter Property="Foreground" Value="{DynamicResource FcOnTarget}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.role.target:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.role.target:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FcTargetFill}" />
    <Setter Property="Foreground" Value="{DynamicResource FcOnTarget}" />
  </Style>

  <!-- Role badges (non-color cue: text) -->
  <Style Selector="Border.badge">
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="Margin" Value="4,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.badge.target">
    <Setter Property="Background" Value="{DynamicResource FcTargetFill}" />
  </Style>
  <Style Selector="Border.badge.target TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource FcOnTarget}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="10.5" />
  </Style>
  <!-- A panel's number (also its handle): the accent while it is the active panel, else the header's muted colors. Theme
       resources, so a theme change recolors every panel's number at once, as it does the TARGET chip (I663). -->
  <Style Selector="Border.panelNumber">
    <Setter Property="Background" Value="{DynamicResource FcHeader}" />
  </Style>
  <Style Selector="Border.panelNumber > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource FcTextMuted}" />
  </Style>
  <Style Selector="Border.panelNumber.active">
    <Setter Property="Background" Value="{DynamicResource FcAccentFill}" />
  </Style>
  <Style Selector="Border.panelNumber.active > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource FcOnAccent}" />
  </Style>

  <!-- Status and key bar -->
  <Style Selector="Border.status">
    <Setter Property="Background" Value="{DynamicResource FcStatusBackground}" />
    <Setter Property="Padding" Value="{DynamicResource FcStatusPadding}" />
  </Style>
  <!-- Where a dragged tab goes: a bar in the accent between two tabs. -->
  <Style Selector="Border.tabDropMarker">
    <Setter Property="Background" Value="{DynamicResource FcActiveAccent}" />
    <Setter Property="CornerRadius" Value="1.5" />
  </Style>
  <!-- A link in a status line (Count): text in the theme's link color, no button chrome, the pointer a hand. -->
  <Style Selector="Button.statuslink">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6,0,0,0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource FcTextLink}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="False" />
  </Style>
  <Style Selector="Button.statuslink:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.statuslink:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource FcText}" />
  </Style>
  <Style Selector="Button.fkey">
    <Setter Property="Background" Value="{DynamicResource FcKeyBarBackground}" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="Margin" Value="1,0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="MinHeight" Value="{DynamicResource FcFKeyHeight}" />
  </Style>
  <!-- A disabled key keeps the bar's background (not Fluent's translucent one); only its text dims. -->
  <Style Selector="Button.fkey:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FcKeyBarBackground}" />
  </Style>
  <Style Selector="Button.fkey:disabled TextBlock">
    <Setter Property="Opacity" Value="0.72" />
  </Style>
  <Style Selector="TextBlock.fkeynum">
    <Setter Property="Foreground" Value="{DynamicResource FcKeyBarKey}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Margin" Value="0,0,4,0" />
  </Style>
  <Style Selector="TextBlock.fkeylabel">
    <Setter Property="Foreground" Value="{DynamicResource FcKeyBarLabel}" />
  </Style>

  <!-- Overlay dialogs -->
  <Style Selector="Border.backdrop">
    <Setter Property="Background" Value="{DynamicResource FcBackdrop}" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource FcCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FcBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BoxShadow" Value="0 8 32 0 #50000000" />
  </Style>
  <Style Selector="Border.dialogHeader">
    <Setter Property="Background" Value="{DynamicResource FcHeader}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FcBorder}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="18,11" />
  </Style>
  <Style Selector="Border.dialogAccent">
    <Setter Property="Background" Value="{DynamicResource FcActiveAccent}" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>
  <Style Selector="Border.dialogBody">
    <Setter Property="Padding" Value="18,10" />
  </Style>
  <Style Selector="Border.reviewHighlights">
    <Setter Property="Background" Value="{DynamicResource FcHeader}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FcActiveAccent}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="12,9" />
  </Style>
  <Style Selector="Border.reviewWarnings">
    <Setter Property="Background" Value="{DynamicResource FcHeader}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FcWarning}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="12,9" />
  </Style>
  <Style Selector="Border.reviewActionCard">
    <Setter Property="Background" Value="{DynamicResource FcCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FcActiveAccent}" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="Padding" Value="0,0,0,7" />
  </Style>
  <Style Selector="SelectableTextBlock.reviewPrimaryAction">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="17" />
  </Style>
  <Style Selector="SelectableTextBlock.reviewDecision">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.reviewDetailSection">
    <Setter Property="BorderBrush" Value="{DynamicResource FcBorder}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="0,0,0,8" />
  </Style>
  <Style Selector="SelectableTextBlock.reviewDetailHeading">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- The permissions inspector: what the item is in the dialog header's color, notes with an edge in the accent (or the
       warning color), and each part of the security information in its own framed section in the card's color. -->
  <Style Selector="Border.permissionSummary">
    <Setter Property="Background" Value="{DynamicResource FcHeader}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FcBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,10" />
  </Style>
  <Style Selector="Border.permissionNote">
    <Setter Property="Background" Value="{DynamicResource FcHeader}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FcActiveAccent}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <Style Selector="Border.permissionNote.warning">
    <Setter Property="BorderBrush" Value="{DynamicResource FcWarning}" />
  </Style>
  <Style Selector="Border.permissionSection">
    <Setter Property="BorderBrush" Value="{DynamicResource FcBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,10" />
  </Style>
  <Style Selector="Border.permissionDetails">
    <Setter Property="BorderBrush" Value="{DynamicResource FcBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="10,8" />
  </Style>
  <Style Selector="TextBlock.permissionHeading">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- An expander (the copy dialog's Options): a quiet row in the dialog's own colors, not a dark bar that looks like a box to type in. -->
  <!-- (The template's borders take these through template bindings, which a style on the borders themselves cannot outrank.) -->
  <Style Selector="Expander">
    <Setter Property="Background" Value="{DynamicResource FcCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FcBorder}" />
  </Style>
  <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
    <Setter Property="Background" Value="{DynamicResource FcCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FcBorder}" />
  </Style>
  <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:pointerover /template/ Border#ToggleButtonBackground">
    <Setter Property="Background" Value="{DynamicResource FcHeader}" />
  </Style>
  <Style Selector="Border.dialogFooter">
    <Setter Property="Background" Value="{DynamicResource FcStatusBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FcBorder}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="18,9" />
  </Style>
  <Style Selector="TextBlock.dialogTitle">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource FcDangerFill}" />
    <Setter Property="Foreground" Value="{DynamicResource FcOnDanger}" />
  </Style>
  <Style Selector="Button.danger:pointerover">
    <Setter Property="Background" Value="{DynamicResource FcDangerFill}" />
    <Setter Property="Foreground" Value="{DynamicResource FcOnDanger}" />
  </Style>
  <Style Selector="Button.danger:pressed">
    <Setter Property="Background" Value="{DynamicResource FcDangerFill}" />
    <Setter Property="Foreground" Value="{DynamicResource FcOnDanger}" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FcDangerFill}" />
    <Setter Property="Foreground" Value="{DynamicResource FcOnDanger}" />
  </Style>
  <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FcDangerFill}" />
    <Setter Property="Foreground" Value="{DynamicResource FcOnDanger}" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource FcAccentFill}" />
    <Setter Property="Foreground" Value="{DynamicResource FcOnAccent}" />
  </Style>
  <!-- Pointed at or pressed, a primary button stays in its color (lighter or darker), its text readable on it. -->
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FcAccentFill}" />
    <Setter Property="Foreground" Value="{DynamicResource FcOnAccent}" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FcAccentFill}" />
    <Setter Property="Foreground" Value="{DynamicResource FcOnAccent}" />
    <Setter Property="Opacity" Value="0.8" />
  </Style>
  <!-- Status text in the palette's hue, made legible (4.5:1) on cards, dialog headers and lists, panels and the window. -->
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{DynamicResource FcErrorText}" />
  </Style>
  <Style Selector="TextBlock.warning">
    <Setter Property="Foreground" Value="{DynamicResource FcWarningText}" />
  </Style>
  <Style Selector="TextBox.warning">
    <Setter Property="Foreground" Value="{DynamicResource FcWarningText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FcWarning}" />
  </Style>
  <Style Selector="TextBlock.success">
    <Setter Property="Foreground" Value="{DynamicResource FcSuccessText}" />
  </Style>
  <!-- Selected text reads as the accent's own text (the highlight is FcActiveAccent, set by ThemeManager). -->
  <Style Selector="TextBox">
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource FcOnAccent}" />
  </Style>
  <Style Selector="SelectableTextBlock">
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource FcOnAccent}" />
    <Setter Property="fc:ReviewText.PathForeground" Value="{DynamicResource FcTextLink}" />
  </Style>
  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource FcProgress}" />
  </Style>
  <!-- Every number box's spin buttons (NumericUpDown's ButtonSpinner): Fluent draws them as icons, and a button named by
       nothing else is named after its content, so a screen reader read "Avalonia.Controls.PathIcon" (I653). -->
  <Style Selector="ButtonSpinner /template/ RepeatButton#PART_IncreaseButton">
    <Setter Property="AutomationProperties.Name" Value="Increase" />
  </Style>
  <Style Selector="ButtonSpinner /template/ RepeatButton#PART_DecreaseButton">
    <Setter Property="AutomationProperties.Name" Value="Decrease" />
  </Style>

  <Style Selector="ListBox.choices">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!-- Suggestions under a text box: clicking one must not take the keyboard from the box. -->
  <Style Selector="ListBox.suggestions ListBoxItem">
    <Setter Property="Focusable" Value="False" />
  </Style>
  <Style Selector="ListBox.choices ListBoxItem">
    <Setter Property="Padding" Value="{DynamicResource FcChoicePadding}" />
    <Setter Property="MinHeight" Value="0" />
    <!-- Room for the chosen row's edge, so choosing does not shift the rows. -->
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <!-- The chosen row looks like a file list's focused row in every theme, not like Fluent's own accent
       (High Contrast: yellow text and edge on black). -->
  <Style Selector="ListBox.choices ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FcFocusBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource FcFocusText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FcFocusBorder}" />
  </Style>
  <Style Selector="ListBox.choices ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FcFocusBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource FcFocusText}" />
  </Style>
  <Style Selector="ListBox.choices ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FcFocusBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource FcFocusText}" />
  </Style>
  <!-- A list inside a dialog (review targets and rules, Undo's actions, editors' entries): a well in the dialog's header
       color, not Fluent's opaque gray, outlined where the header and card colors are the same (High Contrast, DOS
       Commander); its chosen row like a chooser's. -->
  <Style Selector="Border.card ListBox:not(.choices)">
    <Setter Property="Background" Value="{DynamicResource FcHeader}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FcBorder}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.card ListBox:not(.choices) ListBoxItem">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Border.card ListBox:not(.choices) ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FcFocusBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource FcFocusText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FcFocusBorder}" />
  </Style>
  <Style Selector="Border.card ListBox:not(.choices) ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FcFocusBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource FcFocusText}" />
  </Style>
  <Style Selector="Border.card ListBox:not(.choices) ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FcFocusBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource FcFocusText}" />
  </Style>
  <!-- On a chosen row everything reads as the row does: muted details, status words and emphasized paths alike
       (DOS Commander's muted cyan would vanish on its cyan bar). -->
  <Style Selector="ListBox.choices ListBoxItem:selected TextBlock.muted, ListBox.choices ListBoxItem:selected TextBlock.error, ListBox.choices ListBoxItem:selected TextBlock.warning, ListBox.choices ListBoxItem:selected TextBlock.success, Border.card ListBox ListBoxItem:selected TextBlock.muted, Border.card ListBox ListBoxItem:selected TextBlock.error, Border.card ListBox ListBoxItem:selected TextBlock.warning, Border.card ListBox ListBoxItem:selected TextBlock.success">
    <Setter Property="Foreground" Value="{DynamicResource FcFocusText}" />
  </Style>
  <Style Selector="ListBox.choices ListBoxItem:selected SelectableTextBlock, Border.card ListBox ListBoxItem:selected SelectableTextBlock">
    <Setter Property="fc:ReviewText.PathForeground" Value="{DynamicResource FcFocusText}" />
  </Style>
  <!-- A chosen item of a combo box's list has an edge too (in the focus color): High Contrast's yellow box, not color alone. -->
  <Style Selector="ComboBoxItem">
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.notification">
    <Setter Property="Background" Value="{DynamicResource FcCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FcBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="BoxShadow" Value="0 4 16 0 #40000000" />
  </Style>
  <Style Selector="Border.notification.error">
    <Setter Property="BorderBrush" Value="{DynamicResource FcError}" />
    <Setter Property="BorderThickness" Value="1,1,1,1" />
  </Style>

  <Style Selector="Border.quicksearch">
    <Setter Property="Background" Value="{DynamicResource FcCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FcFocusBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="Margin" Value="-5,-1" />
  </Style>
  <Style Selector="Border.quicksearch.nomatch">
    <Setter Property="BorderBrush" Value="{DynamicResource FcError}" />
  </Style>

  <Style Selector="Border.banner">
    <Setter Property="Background" Value="{DynamicResource FcStatusBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FcWarning}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="8,3" />
  </Style>

  <!-- Dialog tabs (Settings): header text at the size of the rest of the dialog, not Fluent's page-title size. -->
  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="{DynamicResource FcDialogTabFontSize}" />
    <Setter Property="MinHeight" Value="{DynamicResource FcDialogTabHeight}" />
    <Setter Property="Padding" Value="{DynamicResource FcDialogTabPadding}" />
  </Style>

  <Style Selector="Menu">
    <!-- Transparent in most themes: the window (or a theme's stained glass) shows through. -->
    <Setter Property="Background" Value="{DynamicResource FcMenuBackground}" />
  </Style>

  <!-- The toolbar (D-49): flat icon buttons that show a frame when pointed at, and thin rules between the groups. -->
  <Style Selector="Border.toolbar">
    <Setter Property="Background" Value="{DynamicResource FcMenuBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FcBorder}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="4,1" />
  </Style>
  <Style Selector="Button.toolbar">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="{DynamicResource FcToolbarPadding}" />
    <Setter Property="Margin" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="{DynamicResource FcToolbarHeight}" />
  </Style>
  <Style Selector="Button.toolbar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FcFocusBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FcBorder}" />
  </Style>
  <Style Selector="Button.toolbar.checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource FcActiveAccent}" />
  </Style>
  <Style Selector="Button.toolbar.historyPrimary">
    <Setter Property="Margin" Value="1,1,0,1" />
  </Style>
  <Style Selector="Button.historyDropdown">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Margin" Value="0,1,2,1" />
    <Setter Property="Padding" Value="3,0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="{DynamicResource FcToolbarHeight}" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.historyDropdown:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FcFocusBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FcBorder}" />
  </Style>
  <!-- A panel's place buttons: small, flat, where the panel is outlined. -->
  <Style Selector="Border.drivebar">
    <Setter Property="Background" Value="{DynamicResource FcPanel}" />
    <Setter Property="Padding" Value="2,1,2,0" />
  </Style>
  <Style Selector="Button.drive">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="{DynamicResource FcDrivePadding}" />
    <Setter Property="Margin" Value="0,0,1,0" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="{DynamicResource FcDriveHeight}" />
    <Setter Property="FontSize" Value="{DynamicResource FcDriveFontSize}" />
  </Style>
  <Style Selector="Button.drive:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FcFocusBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FcBorder}" />
  </Style>
  <Style Selector="Button.drive.current /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource FcActiveAccent}" />
  </Style>
  <!-- Between groups of place buttons: drives, devices, collections, folders, bookmarks, servers. -->
  <Style Selector="Border.placeGap">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Margin" Value="4,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource FcBorder}" />
  </Style>
  <Style Selector="Border.toolbarSeparator">
    <Setter Property="Width" Value="1" />
    <Setter Property="Margin" Value="5,5" />
    <Setter Property="Background" Value="{DynamicResource FcBorder}" />
  </Style>

  <Style Selector="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource FcCard}" />
  </Style>
  <Style Selector="ContextMenu MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource FcText}" />
  </Style>
  <Style Selector="ContextMenu MenuItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource FcFocusBackground}" />
  </Style>
  <Style Selector="ContextMenu Separator">
    <Setter Property="Background" Value="{DynamicResource FcBorder}" />
  </Style>

  <!-- Tooltips: the theme's own surface, as its menus and notifications have, not the platform's (I80). -->
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource FcTipBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource FcText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FcBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="MaxWidth" Value="420" />
    <Setter Property="FontFamily" Value="{DynamicResource FcFontFamily}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="ToolTip TextBlock.tipTitle">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="ToolTip TextBlock.tipKey">
    <Setter Property="Foreground" Value="{DynamicResource FcTipKey}" />
    <Setter Property="FontSize" Value="11.5" />
  </Style>
  <Style Selector="ToolTip TextBlock.tipHint">
    <Setter Property="Foreground" Value="{DynamicResource FcTextMuted}" />
    <Setter Property="FontSize" Value="11.5" />
  </Style>
  <!-- A legend's terms and a value tooltip's parts: what to look at first stands out, where it came from recedes. -->
  <Style Selector="ToolTip TextBlock.tipTerm">
    <Setter Property="Foreground" Value="{DynamicResource FcTipKey}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="ToolTip TextBlock.tipLabel">
    <Setter Property="Foreground" Value="{DynamicResource FcTextMuted}" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="ToolTip TextBlock.tipValue">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="13.5" />
  </Style>
  <Style Selector="ToolTip TextBlock.tipCode">
    <Setter Property="Foreground" Value="{DynamicResource FcTipKey}" />
    <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace" />
    <Setter Property="FontSize" Value="11.5" />
  </Style>
  <Style Selector="ToolTip TextBlock.tipSource">
    <Setter Property="Foreground" Value="{DynamicResource FcTextMuted}" />
    <Setter Property="FontSize" Value="11" />
  </Style>

</Styles>
