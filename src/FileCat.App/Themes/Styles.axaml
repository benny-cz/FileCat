<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- All colors come from semantic Fc* tokens supplied by ThemeManager (plan §18.2). -->

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource FcWindow}" />
    <Setter Property="Foreground" Value="{DynamicResource FcText}" />
    <Setter Property="FontFamily" Value="{DynamicResource FcFontFamily}" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource FcPanel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FcBorder}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <!-- Where F5 and F6 go: the target's frame is in the target color (the active panel's is thicker, in the active color) -->
  <Style Selector="Border.panel.target">
    <Setter Property="BorderBrush" Value="{DynamicResource FcTargetAccent}" />
  </Style>
  <Style Selector="Border.panel.active">
    <Setter Property="BorderBrush" Value="{DynamicResource FcActiveAccent}" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource FcTextMuted}" />
  </Style>
  <Style Selector="TextBlock.small">
    <Setter Property="FontSize" Value="11.5" />
  </Style>

  <!-- Tab strip -->
  <Style Selector="Button.tab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource FcTextMuted}" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="Margin" Value="0,0,1,0" />
    <Setter Property="CornerRadius" Value="4,4,0,0" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Focusable" Value="False" />
  </Style>
  <Style Selector="Button.tab.current">
    <Setter Property="Background" Value="{DynamicResource FcPanel}" />
    <Setter Property="Foreground" Value="{DynamicResource FcText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FcActiveAccent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.flat">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Focusable" Value="False" />
  </Style>

  <!-- Path box: reads like a label until focused -->
  <Style Selector="TextBox.path">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <!-- The filter box, and while it filters: in the accent color, so a filtered panel is not taken for a whole folder. -->
  <Style Selector="TextBox.filter">
    <Setter Property="Foreground" Value="{DynamicResource FcTextMuted}" />
    <Setter Property="HorizontalContentAlignment" Value="Right" />
  </Style>
  <Style Selector="TextBox.filter.active">
    <Setter Property="Foreground" Value="{DynamicResource FcActiveAccent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- While the path shows as links, the box beneath keeps its text to itself (translucent themes would show it). -->
  <Style Selector="TextBox.path.linked /template/ TextPresenter#PART_TextPresenter">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="TextBox.path:focus">
    <Setter Property="Background" Value="{DynamicResource FcCard}" />
  </Style>
  <Style Selector="TextBox.path:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource FcFocusBorder}" />
    <Setter Property="Background" Value="{DynamicResource FcCard}" />
  </Style>
  <Style Selector="TextBox.path /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- Where a dragged panel would go: the focus color, or the error color when there is no room -->
  <Style Selector="Border.dockPreview">
    <Setter Property="Background" Value="{DynamicResource FcFocusBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FcFocusBorder}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Opacity" Value="0.85" />
  </Style>
  <Style Selector="Border.dockPreview.refused">
    <Setter Property="BorderBrush" Value="{DynamicResource FcError}" />
  </Style>
  <Style Selector="TextBlock.dockPreview">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource FcFocusText}" />
  </Style>

  <!-- Command search in the menu bar: a field on the menu's glass, outlined in the focus color while typing -->
  <Style Selector="TextBox.commandSearch">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.commandSearch /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource FcCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FcBorder}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TextBox.commandSearch:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource FcFocusBorder}" />
  </Style>

  <!-- Role chips (non-color cue: text): TARGET, "Set as target" on the other panels, the active panel's own target -->
  <Style Selector="Button.role">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="Margin" Value="4,2" />
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource FcBorder}" />
    <Setter Property="Foreground" Value="{DynamicResource FcTextMuted}" />
  </Style>
  <Style Selector="Button.role:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource FcTargetAccent}" />
    <Setter Property="Foreground" Value="{DynamicResource FcText}" />
  </Style>
  <Style Selector="Button.role.target">
    <Setter Property="Background" Value="{DynamicResource FcTargetFill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FcTargetAccent}" />
    <Setter Property="Foreground" Value="{DynamicResource FcOnTarget}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.role.target:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.role.target:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FcTargetFill}" />
    <Setter Property="Foreground" Value="{DynamicResource FcOnTarget}" />
  </Style>

  <!-- Role badges (non-color cue: text) -->
  <Style Selector="Border.badge">
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="Margin" Value="4,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.badge.target">
    <Setter Property="Background" Value="{DynamicResource FcTargetFill}" />
  </Style>
  <Style Selector="Border.badge.target TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource FcOnTarget}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="10.5" />
  </Style>

  <!-- Status and key bar -->
  <Style Selector="Border.status">
    <Setter Property="Background" Value="{DynamicResource FcStatusBackground}" />
    <Setter Property="Padding" Value="6,2" />
  </Style>
  <Style Selector="Button.fkey">
    <Setter Property="Background" Value="{DynamicResource FcKeyBarBackground}" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="Margin" Value="1,0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="MinHeight" Value="22" />
  </Style>
  <!-- A disabled key keeps the bar's background (not Fluent's translucent one); only its text dims. -->
  <Style Selector="Button.fkey:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FcKeyBarBackground}" />
  </Style>
  <Style Selector="Button.fkey:disabled TextBlock">
    <Setter Property="Opacity" Value="0.72" />
  </Style>
  <Style Selector="TextBlock.fkeynum">
    <Setter Property="Foreground" Value="{DynamicResource FcKeyBarKey}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Margin" Value="0,0,4,0" />
  </Style>
  <Style Selector="TextBlock.fkeylabel">
    <Setter Property="Foreground" Value="{DynamicResource FcKeyBarLabel}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- Overlay dialogs -->
  <Style Selector="Border.backdrop">
    <Setter Property="Background" Value="{DynamicResource FcBackdrop}" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource FcCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FcBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BoxShadow" Value="0 8 32 0 #50000000" />
  </Style>
  <Style Selector="Border.dialogHeader">
    <Setter Property="Background" Value="{DynamicResource FcHeader}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FcBorder}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="18,11" />
  </Style>
  <Style Selector="Border.dialogAccent">
    <Setter Property="Background" Value="{DynamicResource FcActiveAccent}" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>
  <Style Selector="Border.dialogBody">
    <Setter Property="Padding" Value="18,10" />
  </Style>
  <Style Selector="Border.dialogFooter">
    <Setter Property="Background" Value="{DynamicResource FcStatusBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FcBorder}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="18,9" />
  </Style>
  <Style Selector="TextBlock.dialogTitle">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource FcError}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource FcAccentFill}" />
    <Setter Property="Foreground" Value="{DynamicResource FcOnAccent}" />
  </Style>
  <!-- Pointed at or pressed, a primary button stays in its color (lighter or darker), its text readable on it. -->
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FcAccentFill}" />
    <Setter Property="Foreground" Value="{DynamicResource FcOnAccent}" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FcAccentFill}" />
    <Setter Property="Foreground" Value="{DynamicResource FcOnAccent}" />
    <Setter Property="Opacity" Value="0.8" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{DynamicResource FcError}" />
  </Style>
  <Style Selector="TextBlock.warning">
    <Setter Property="Foreground" Value="{DynamicResource FcWarning}" />
  </Style>

  <Style Selector="ListBox.choices">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!-- Suggestions under a text box: clicking one must not take the keyboard from the box. -->
  <Style Selector="ListBox.suggestions ListBoxItem">
    <Setter Property="Focusable" Value="False" />
  </Style>
  <Style Selector="ListBox.choices ListBoxItem">
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="MinHeight" Value="0" />
    <!-- Room for the chosen row's edge, so choosing does not shift the rows. -->
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <!-- The chosen row looks like a file list's focused row in every theme, not like Fluent's own accent
       (High Contrast: yellow text and edge on black). -->
  <Style Selector="ListBox.choices ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FcFocusBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource FcFocusText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FcFocusBorder}" />
  </Style>
  <Style Selector="ListBox.choices ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FcFocusBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource FcFocusText}" />
  </Style>
  <Style Selector="ListBox.choices ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FcFocusBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource FcFocusText}" />
  </Style>

  <Style Selector="Border.notification">
    <Setter Property="Background" Value="{DynamicResource FcCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FcBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="BoxShadow" Value="0 4 16 0 #40000000" />
  </Style>
  <Style Selector="Border.notification.error">
    <Setter Property="BorderBrush" Value="{DynamicResource FcError}" />
    <Setter Property="BorderThickness" Value="1,1,1,1" />
  </Style>

  <Style Selector="Border.quicksearch">
    <Setter Property="Background" Value="{DynamicResource FcCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FcFocusBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="Margin" Value="-5,-1" />
  </Style>
  <Style Selector="Border.quicksearch.nomatch">
    <Setter Property="BorderBrush" Value="{DynamicResource FcError}" />
  </Style>

  <Style Selector="Border.banner">
    <Setter Property="Background" Value="{DynamicResource FcStatusBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FcWarning}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="8,3" />
  </Style>

  <!-- Dialog tabs (Settings): header text at the size of the rest of the dialog, not Fluent's page-title size. -->
  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="10,2" />
  </Style>

  <Style Selector="Menu">
    <!-- Transparent in most themes: the window (or a theme's stained glass) shows through. -->
    <Setter Property="Background" Value="{DynamicResource FcMenuBackground}" />
  </Style>

  <!-- The toolbar (D-49): flat icon buttons that show a frame when pointed at, and thin rules between the groups. -->
  <Style Selector="Border.toolbar">
    <Setter Property="Background" Value="{DynamicResource FcMenuBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FcBorder}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="4,1" />
  </Style>
  <Style Selector="Button.toolbar">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="Margin" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="Button.toolbar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FcFocusBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FcBorder}" />
  </Style>
  <Style Selector="Button.toolbar.checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource FcActiveAccent}" />
  </Style>
  <!-- A panel's place buttons: small, flat, where the panel is outlined. -->
  <Style Selector="Border.drivebar">
    <Setter Property="Background" Value="{DynamicResource FcPanel}" />
    <Setter Property="Padding" Value="2,1,2,0" />
  </Style>
  <Style Selector="Button.drive">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="3,1" />
    <Setter Property="Margin" Value="0,0,1,0" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="Button.drive:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FcFocusBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FcBorder}" />
  </Style>
  <Style Selector="Button.drive.current /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource FcActiveAccent}" />
  </Style>
  <!-- Between groups of place buttons: drives, devices, collections, folders, bookmarks, servers. -->
  <Style Selector="Border.placeGap">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Margin" Value="4,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource FcBorder}" />
  </Style>
  <Style Selector="Border.toolbarSeparator">
    <Setter Property="Width" Value="1" />
    <Setter Property="Margin" Value="5,5" />
    <Setter Property="Background" Value="{DynamicResource FcBorder}" />
  </Style>

  <Style Selector="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource FcCard}" />
  </Style>
  <Style Selector="ContextMenu MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource FcText}" />
  </Style>
  <Style Selector="ContextMenu MenuItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource FcFocusBackground}" />
  </Style>
  <Style Selector="ContextMenu Separator">
    <Setter Property="Background" Value="{DynamicResource FcBorder}" />
  </Style>
</Styles>
