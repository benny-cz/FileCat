<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>FileCat.App</RootNamespace>
    <AssemblyName>FileCat</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets/filecat.ico</ApplicationIcon>
    <Description>FileCat — keyboard-first dual-panel file manager</Description>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- WebKitGTK's entry points and callbacks are function pointers (D-51). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FileCat.Core\FileCat.Core.csproj" />
    <ProjectReference Include="..\FileCat.Platform.Windows\FileCat.Platform.Windows.csproj" />
    <ProjectReference Include="..\FileCat.Remote\FileCat.Remote.csproj" />
    <ProjectReference Include="..\FileCat.Archives\FileCat.Archives.csproj" />
    <ProjectReference Include="..\FileCat.Recovery\FileCat.Recovery.csproj" />
    <!-- The Shell helper (TV-16) sits beside FileCat.exe; FileCat starts it on first use. -->
    <ProjectReference Include="..\FileCat.ShellHost\FileCat.ShellHost.csproj" />
    <InternalsVisibleTo Include="FileCat.App.Tests" />
  </ItemGroup>
</Project>
