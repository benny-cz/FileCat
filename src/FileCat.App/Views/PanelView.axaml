<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FileCat.App.ViewModels"
             xmlns:ctl="using:FileCat.App.Controls"
             x:Class="FileCat.App.Views.PanelView"
             x:DataType="vm:PanelViewModel">
  <Border Classes="panel" Classes.active="{Binding IsActive}" Classes.target="{Binding IsTarget}" CornerRadius="4" BorderThickness="{Binding IsActive, Converter={x:Static vm:Converters.ActiveBorder}}">
    <DockPanel>
      <!-- Tabs -->
      <Grid x:Name="TabHeader" DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto" Background="{DynamicResource FcHeader}">
        <ScrollViewer x:Name="TabScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="TabStrip" ItemsSource="{Binding Tabs}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TabViewModel">
                <Button Classes="tab" Classes.current="{Binding IsActiveTab}" Click="OnTabClick" Tag="{Binding}"
                        ToolTip.Tip="{Binding TabTooltip}" AutomationProperties.Name="{Binding TabAccessibleName}"
                        AutomationProperties.HelpText="{Binding TabLockDescription}" PointerReleased="OnTabPointerReleased">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding TabHeader}" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="⟳" IsVisible="{Binding ShowsBusy}" Classes="muted" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <!-- Shown only when the tabs do not all fit: every tab, including the hidden ones. -->
        <Button x:Name="TabOverflow" Grid.Column="1" Classes="flat" Content="⋯" Click="OnTabOverflowClick" IsVisible="False"
                ToolTip.Tip="All tabs (Ctrl+Shift+L)" AutomationProperties.Name="All tabs" />
        <Button x:Name="SortButton" Grid.Column="2" Classes="flat" Content="Sort ▾" Click="OnSortClick"
                ToolTip.Tip="{Binding ActiveTab.SortDescription}"
                AutomationProperties.Name="{Binding ActiveTab.SortDescription}"
                AutomationProperties.HelpText="Choose a visible column to sort by. Choosing the current column reverses its order." />
        <Button Grid.Column="3" Classes="flat" Content="+" Click="OnNewTabClick" ToolTip.Tip="New tab (Ctrl+T)" />
      </Grid>

      <!-- Place buttons: every place of the location menu with one click (D-52, D-53), as Total Commander's drive bar.
           One row: what does not fit is on the » button at its end. -->
      <Border x:Name="DriveBar" DockPanel.Dock="Top" Classes="drivebar"
              IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowDriveButtons, FallbackValue=True}">
        <ctl:PlaceBarPanel x:Name="DriveButtonsPanel" />
      </Border>

      <!-- Address row -->
      <Grid x:Name="AddressRow" DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto" Background="{DynamicResource FcPanel}">
        <!-- The panel's number is also its handle: drag it onto another panel to move this one (ADR-18). Its colors come
             from the panelNumber style's theme resources, so they follow a theme change (I663). The number's own transparent
             background makes the whole handle take presses, whatever the style paints behind it. -->
        <Border x:Name="NumberBadge" Classes="panelNumber" Classes.active="{Binding IsActive}" Margin="4,2,0,2" CornerRadius="3"
                VerticalAlignment="Center" Cursor="SizeAll"
                ToolTip.Tip="Panel number · drag onto another panel: an edge puts this panel beside it, the middle swaps them (Alt+Shift+arrows move it)">
          <TextBlock Text="{Binding Number}" FontWeight="Bold" FontSize="11" Padding="5,0" Background="Transparent" />
        </Border>
        <Button Grid.Column="1" Classes="flat" Content="▾" Click="OnLocationMenuClick" ToolTip.Tip="Change location (Alt+F1 / Alt+F2)" />
        <!-- The path: its folders are links (PathLine) until it is edited in the box beneath (a click on its last part). -->
        <Panel x:Name="PathCell" Grid.Column="2">
          <ctl:PanelAddressTextBox x:Name="PathBox" Classes="path linked" Text="{Binding ActiveTab.DisplayPath, Mode=OneWay}"
                   AutomationProperties.Name="Location" />
          <ctl:PathLine x:Name="PathLinks" Margin="6,0" />
        </Panel>
        <!-- This belongs to the displayed file-system volume; archives and virtual locations do not show stale space. -->
        <TextBlock x:Name="FreeSpaceLabel" Grid.Column="3" Text="{Binding ActiveTab.FreeSpaceText}" Classes="small muted" Margin="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   IsVisible="{Binding ActiveTab.FreeSpaceText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   ToolTip.Tip="{Binding ActiveTab.FreeSpaceText}" />
        <!-- Which items show: a mask such as *.txt;*.log, applied on Enter ("*.*" or "*" shows everything). -->
        <ctl:PanelAddressTextBox x:Name="FilterBox" Grid.Column="4" Classes="path filter" Width="96"
                 AutomationProperties.Name="Filter"
                 AutomationProperties.HelpText="{Binding ActiveTab.FilterValidationError}"
                 ToolTip.Tip="Ctrl+Shift+F focuses this field. Show only matching items: *.txt;*.log; after |, exclude matches (*.*|*.tmp). Enter applies, Esc restores. Folders always show." />
        <TextBlock x:Name="FilterError" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="4"
                   HorizontalAlignment="Right" MaxWidth="400" Margin="4,0,4,3"
                   Classes="small warning" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2"
                   AutomationProperties.Name="Filter validation"
                   Text="{Binding ActiveTab.FilterValidationError}"
                   ToolTip.Tip="{Binding ActiveTab.FilterValidationError}"
                   IsVisible="{Binding ActiveTab.FilterValidationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <!-- The visible error can disappear. Keep its announcement on a stable, nonempty AX node. -->
        <TextBlock x:Name="FilterAnnouncement" Grid.Column="4" Width="1" Height="1" Opacity="0"
                   IsHitTestVisible="False" Text="Filter ready" AutomationProperties.LiveSetting="Assertive" />
        <!-- TARGET, "Set as target" on the other panels, or the active panel's own target (plan §4.2). -->
        <Button x:Name="RoleButton" Grid.Column="5" Classes="role" Classes.target="{Binding IsTarget}" Classes.offer="{Binding OffersTarget}"
                ToolTip.Tip="{Binding RoleTip}" AutomationProperties.Name="{Binding RoleTip}" Click="OnRoleClick"
                IsVisible="{Binding RoleLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Text="{Binding RoleLabel}" MaxWidth="80" TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" TextAlignment="Center" />
        </Button>
      </Grid>

      <!-- Status -->
      <!-- The focused item's part takes at most 45% of the bar (set as it resizes), so the folder's counts stay readable;
           either part, cut short, shows all of it on hover. -->
      <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Classes="status">
        <Grid ColumnDefinitions="*,Auto">
          <!-- With items marked, what they are and their size comes first, in the mark color, and Count counts the marked
               folders' sizes where they are not counted; the rest of the line (free space, filter, checksums) follows. -->
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="{Binding ActiveTab.StatusMarked}" Classes="small" FontWeight="SemiBold"
                       Foreground="{DynamicResource FcTextMarked}" TextTrimming="CharacterEllipsis"
                       IsVisible="{Binding ActiveTab.StatusMarked, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       ToolTip.Tip="{Binding ActiveTab.StatusMarked}" />
            <Button x:Name="CountSizesButton" DockPanel.Dock="Left" Classes="statuslink" Click="OnCountFolderSizes"
                    IsVisible="{Binding ActiveTab.CanCountMarked}"
                    ToolTip.Tip="Counts the sizes of the marked folders in the background (Esc stops it)"
                    AutomationProperties.Name="Count the marked folders' sizes">
              <TextBlock Classes="small" Text="Count" TextDecorations="Underline" />
            </Button>
            <TextBlock Text="{Binding ActiveTab.StatusLeft}" Classes="small" TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding ActiveTab.StatusLeft}"
                       ToolTip.ServiceEnabled="{Binding ActiveTab.StatusLeft, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </DockPanel>
          <TextBlock x:Name="StatusRightText" Grid.Column="1" Text="{Binding ActiveTab.StatusRight}" Classes="small" Margin="12,0,0,0"
                     MaxWidth="420" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ActiveTab.StatusRight}"
                     ToolTip.ServiceEnabled="{Binding ActiveTab.StatusRight, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <!-- Typing in the list searches it (plan §4.3). The search shows here, over the status, so it never hides the
               item it found at the bottom of the list. -->
          <Border Grid.ColumnSpan="2" Classes="quicksearch" Classes.nomatch="{Binding ActiveTab.ShownQuickSearchNoMatch}"
                  IsVisible="{Binding ActiveTab.IsQuickSearchActive}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Classes="small" Text="Quick search: " />
              <TextBlock Classes="small" Text="{Binding ActiveTab.ShownQuickSearch}" FontWeight="Bold" />
              <TextBlock Classes="small" Text="  · searching…" IsVisible="{Binding ActiveTab.IsQuickSearchPending}" />
              <TextBlock Classes="small warning" Text="  · no name matches" IsVisible="{Binding ActiveTab.ShownQuickSearchNoMatch}" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- Comparison / issue banners -->
      <Border DockPanel.Dock="Top" Classes="banner"
              IsVisible="{Binding ActiveTab.DeniedFolderVolume, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <Button Content="Reopen folder as administrator…" HorizontalAlignment="Left" Click="OnReopenDeniedFolder"
                AutomationProperties.HelpText="Windows asks for approval and opens this folder in a separate FileCat window." />
      </Border>
      <Border DockPanel.Dock="Top" Classes="banner" IsVisible="{Binding ActiveTab.CanReopenDeniedRegistry}">
        <Button Content="Reopen Registry key as administrator…" HorizontalAlignment="Left" Click="OnReopenDeniedRegistry" />
      </Border>
      <Border DockPanel.Dock="Top" Classes="banner" IsVisible="{Binding ActiveTab.AnalysisStatus, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Classes="small" Text="{Binding ActiveTab.AnalysisStatus}" />
      </Border>
      <Border DockPanel.Dock="Top" Classes="banner" IsVisible="{Binding ActiveTab.ComparisonLabel, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Classes="small" Text="{Binding ActiveTab.ComparisonLabel}" />
      </Border>
      <Border DockPanel.Dock="Top" Classes="banner" IsVisible="{Binding ActiveTab.Banner, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="small warning" Text="{Binding ActiveTab.Banner}" TextWrapping="Wrap" />
          <Button Grid.Column="1" Classes="flat" Content="✕" Click="OnDismissBanner" ToolTip.Tip="Dismiss" />
        </Grid>
      </Border>

      <Border DockPanel.Dock="Top" Classes="banner" IsVisible="{Binding ActiveTab.IsSupplementaryData}">
        <StackPanel Spacing="4">
          <TextBlock Classes="small" Text="{Binding ActiveTab.SupplementaryInventoryText}" TextWrapping="Wrap"
                     AutomationProperties.Name="Supplementary data inventory" />
          <WrapPanel ItemSpacing="8" LineSpacing="4">
            <Button Content="Read extended attributes…" HorizontalAlignment="Left"
                    IsVisible="{Binding ActiveTab.CanReadSupplementaryEas}" Click="OnReadSupplementaryEas"
                    AutomationProperties.Name="Read extended attributes"
                    AutomationProperties.HelpText="Windows returns extended attribute names and values together. Review before issuing that query." />
            <Button Content="Report selected value…" HorizontalAlignment="Left"
                    IsVisible="{Binding ActiveTab.SupportsSupplementaryReports}" IsEnabled="{Binding ActiveTab.CanReadSupplementaryReport}"
                    Click="OnReadSupplementaryReport" AutomationProperties.Name="Report selected value"
                    AutomationProperties.HelpText="Reads a bounded preview of the focused supplementary value from the reviewed file." />
          </WrapPanel>
        </StackPanel>
      </Border>

      <Panel>
        <ctl:QuickViewPane x:Name="QuickView" IsVisible="{Binding QuickViewSource, Converter={x:Static ObjectConverters.IsNotNull}}"
                           Background="{DynamicResource FcPanel}" ZIndex="1" />
        <ctl:FileListControl x:Name="List" Tab="{Binding ActiveTab}" IsActivePanel="{Binding IsActive}"
                             PictureMode="{Binding ActiveTab.PictureView}"
                             FontSize="{Binding $parent[Window].((vm:MainViewModel)DataContext).ListFontSize, FallbackValue=13}"
                             ComfortableRows="{Binding $parent[Window].((vm:MainViewModel)DataContext).ComfortableDensity, FallbackValue=False}"
                             AutomationProperties.Name="File list" />
        <Canvas x:Name="RenameOverlay" ZIndex="2" IsVisible="False" />
      </Panel>
    </DockPanel>
  </Border>
</UserControl>
