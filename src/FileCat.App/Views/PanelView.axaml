<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FileCat.App.ViewModels"
             xmlns:ctl="using:FileCat.App.Controls"
             x:Class="FileCat.App.Views.PanelView"
             x:DataType="vm:PanelViewModel">
  <Border Classes="panel" Classes.active="{Binding IsActive}" Classes.target="{Binding IsTarget}" CornerRadius="4" BorderThickness="{Binding IsActive, Converter={x:Static vm:Converters.ActiveBorder}}">
    <DockPanel>
      <!-- Tabs -->
      <Grid x:Name="TabHeader" DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Background="{DynamicResource FcHeader}">
        <ScrollViewer x:Name="TabScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="TabStrip" ItemsSource="{Binding Tabs}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TabViewModel">
                <Button Classes="tab" Classes.current="{Binding IsActiveTab}" Click="OnTabClick" Tag="{Binding}"
                        ToolTip.Tip="{Binding DisplayPath}" PointerReleased="OnTabPointerReleased">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding TabHeader}" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="⟳" IsVisible="{Binding IsLoading}" Classes="muted" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <!-- Shown only when the tabs do not all fit: every tab, including the hidden ones. -->
        <Button x:Name="TabOverflow" Grid.Column="1" Classes="flat" Content="⋯" Click="OnTabOverflowClick" IsVisible="False"
                ToolTip.Tip="All tabs (Ctrl+Shift+L)" AutomationProperties.Name="All tabs" />
        <Button Grid.Column="2" Classes="flat" Content="+" Click="OnNewTabClick" ToolTip.Tip="New tab (Ctrl+T)" />
      </Grid>

      <!-- Place buttons: every place of the location menu with one click (D-52, D-53), as Total Commander's drive bar.
           One row: what does not fit is on the » button at its end. -->
      <Border x:Name="DriveBar" DockPanel.Dock="Top" Classes="drivebar"
              IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowDriveButtons, FallbackValue=True}">
        <ctl:PlaceBarPanel x:Name="DriveButtonsPanel" />
      </Border>

      <!-- Address row -->
      <Grid x:Name="AddressRow" DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*,Auto,Auto" Background="{DynamicResource FcPanel}">
        <!-- The panel's number is also its handle: drag it onto another panel to move this one (ADR-18). -->
        <Border x:Name="NumberBadge" Margin="4,2,0,2" CornerRadius="3" Padding="5,0" VerticalAlignment="Center" Cursor="SizeAll"
                Background="{Binding IsActive, Converter={x:Static vm:Converters.ActiveAccent}}"
                ToolTip.Tip="Panel number · drag onto another panel: an edge puts this panel beside it, the middle swaps them (Alt+Shift+arrows move it)">
          <TextBlock Text="{Binding Number}" FontWeight="Bold" FontSize="11"
                     Foreground="{Binding IsActive, Converter={x:Static vm:Converters.ActiveAccentText}}" />
        </Border>
        <Button Grid.Column="1" Classes="flat" Content="▾" Click="OnLocationMenuClick" ToolTip.Tip="Change location (Alt+F1 / Alt+F2)" />
        <!-- The path: its folders are links (PathLine) until it is edited in the box beneath (a click on its last part). -->
        <Panel Grid.Column="2">
          <TextBox x:Name="PathBox" Classes="path linked" Text="{Binding ActiveTab.DisplayPath, Mode=OneWay}"
                   AutomationProperties.Name="Location" />
          <ctl:PathLine x:Name="PathLinks" Margin="6,0" AutomationProperties.Name="Path" />
        </Panel>
        <!-- Which items show: a mask such as *.txt;*.log, applied on Enter ("*.*" or "*" shows everything). -->
        <TextBox x:Name="FilterBox" Grid.Column="3" Classes="path filter" Width="96"
                 AutomationProperties.Name="Filter"
                 ToolTip.Tip="Show only the items that match: *.txt;*.log, and after | what to leave out (*.*|*.tmp). Enter applies, Esc restores. Folders always show." />
        <!-- TARGET, "Set as target" on the other panels, or the active panel's own target (plan §4.2). -->
        <Button x:Name="RoleButton" Grid.Column="4" Classes="role" Classes.target="{Binding IsTarget}" Classes.offer="{Binding OffersTarget}"
                Content="{Binding RoleLabel}" ToolTip.Tip="{Binding RoleTip}" AutomationProperties.Name="{Binding RoleTip}" Click="OnRoleClick"
                IsVisible="{Binding RoleLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </Grid>

      <!-- Status -->
      <!-- The focused item's part takes at most 45% of the bar (set as it resizes), so the folder's counts stay readable;
           either part, cut short, shows all of it on hover. -->
      <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Classes="status">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding ActiveTab.StatusLeft}" Classes="small" TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding ActiveTab.StatusLeft}"
                     ToolTip.ServiceEnabled="{Binding ActiveTab.StatusLeft, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock x:Name="StatusRightText" Grid.Column="1" Text="{Binding ActiveTab.StatusRight}" Classes="small" Margin="12,0,0,0"
                     MaxWidth="420" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ActiveTab.StatusRight}"
                     ToolTip.ServiceEnabled="{Binding ActiveTab.StatusRight, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <!-- Typing in the list searches it (plan §4.3). The search shows here, over the status, so it never hides the
               item it found at the bottom of the list. -->
          <Border Grid.ColumnSpan="2" Classes="quicksearch" Classes.nomatch="{Binding ActiveTab.QuickSearchNoMatch}"
                  IsVisible="{Binding ActiveTab.IsQuickSearchActive}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Classes="small" Text="Quick search: " />
              <TextBlock Classes="small" Text="{Binding ActiveTab.QuickSearch}" FontWeight="Bold" />
              <TextBlock Classes="small warning" Text="  · no name matches" IsVisible="{Binding ActiveTab.QuickSearchNoMatch}" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- Comparison / issue banners -->
      <Border DockPanel.Dock="Top" Classes="banner" IsVisible="{Binding ActiveTab.AnalysisStatus, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Classes="small" Text="{Binding ActiveTab.AnalysisStatus}" />
      </Border>
      <Border DockPanel.Dock="Top" Classes="banner" IsVisible="{Binding ActiveTab.ComparisonLabel, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Classes="small" Text="{Binding ActiveTab.ComparisonLabel}" />
      </Border>
      <Border DockPanel.Dock="Top" Classes="banner" IsVisible="{Binding ActiveTab.Banner, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="small warning" Text="{Binding ActiveTab.Banner}" TextWrapping="Wrap" />
          <Button Grid.Column="1" Classes="flat" Content="✕" Click="OnDismissBanner" ToolTip.Tip="Dismiss" />
        </Grid>
      </Border>

      <Panel>
        <ctl:QuickViewPane x:Name="QuickView" IsVisible="{Binding QuickViewSource, Converter={x:Static ObjectConverters.IsNotNull}}"
                           Background="{DynamicResource FcPanel}" ZIndex="1" />
        <ctl:FileListControl x:Name="List" Tab="{Binding ActiveTab}" IsActivePanel="{Binding IsActive}"
                             FontSize="{Binding $parent[Window].((vm:MainViewModel)DataContext).ListFontSize, FallbackValue=13}"
                             AutomationProperties.Name="File list" />
      </Panel>
    </DockPanel>
  </Border>
</UserControl>
