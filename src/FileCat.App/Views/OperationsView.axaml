<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FileCat.App.ViewModels"
             xmlns:jobs="using:FileCat.Core.Jobs"
             xmlns:services="using:FileCat.App.Services"
             xmlns:controls="using:FileCat.App.Controls"
             x:Class="FileCat.App.Views.OperationsView"
             x:DataType="vm:OperationCenterViewModel">
  <StackPanel>
    <!-- Compact strip: the most relevant operation -->
    <Border Classes="status" IsVisible="{Binding HasVisibleWork}" BorderBrush="{DynamicResource FcBorder}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto" DataContext="{Binding Primary}" x:DataType="vm:JobViewModel">
        <!-- What it does and how far, in words and as a bar with its percentage; then the file in hand, a large one with a
             bar of its own (release issue I30). -->
        <StackPanel Spacing="3" Margin="0,3">
          <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Classes="small" FontWeight="SemiBold" />
          <TextBlock TextTrimming="CharacterEllipsis" Classes="small">
            <Run Text="{Binding PhaseText}" FontWeight="SemiBold" />
            <Run Text=" · " />
            <Run Text="{Binding DetailText}" />
          </TextBlock>
          <TextBlock Text="{Binding Route}" Classes="small muted" TextTrimming="CharacterEllipsis"
                     IsVisible="{Binding Route, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" ToolTip.Tip="{Binding Route}" />
          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsActive}">
            <ProgressBar Height="6" MinHeight="6" Minimum="0" Maximum="100" Value="{Binding Percent}" IsIndeterminate="{Binding IsIndeterminate}"
                         VerticalAlignment="Center" AutomationProperties.Name="Progress of the operation" />
            <TextBlock Grid.Column="1" Text="{Binding PercentText}" Classes="small" FontWeight="SemiBold" MinWidth="38" TextAlignment="Right"
                       VerticalAlignment="Center" Margin="8,0,0,0" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsActive}">
            <TextBlock Text="{Binding CurrentFileText}" Classes="small muted" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <ProgressBar Grid.Column="1" Width="160" Height="3" MinHeight="3" Minimum="0" Maximum="100" Value="{Binding CurrentFilePercent}"
                         IsVisible="{Binding ShowsFileProgress}" VerticalAlignment="Center" Margin="8,0,46,0"
                         AutomationProperties.Name="Progress of the current file" />
          </Grid>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="8,0,0,0">
          <Button Content="Review decision…" IsVisible="{Binding NeedsDecision}" Click="OnReviewDecision"
                  ToolTip.Tip="Review this operation's waiting decision; background work does not interrupt your typing" />
          <Button Classes="flat" Content="Pause" IsVisible="{Binding CanPause}" Click="OnPause" ToolTip.Tip="Pause at the next safe point" />
          <Button Classes="flat" Content="{Binding ResumeLabel}" IsVisible="{Binding CanResume}" Click="OnResume" />
          <Button Classes="flat" Content="Cancel" IsVisible="{Binding !IsFinished}" Click="OnCancel" ToolTip.Tip="Stops at the next safe step; completed steps are kept" />
          <Button Classes="flat" Content="Undo" IsVisible="{Binding CanUndo}" Click="OnUndo" />
          <Button Classes="flat" Content="Undo report" IsVisible="{Binding CanShowUndoReport}" Click="OnShowUndoReport"
                  ToolTip.Tip="Reopen the complete retained Undo outcomes; Copy all copies the report" />
          <Button Classes="flat" Content="Results" IsVisible="{Binding CanShowResults}" Click="OnShowResults"
                  ToolTip.Tip="What the check found, file by file: each checksum's expected and computed values, and each signature" />
          <Button Classes="flat" Content="Retry as administrator…" IsVisible="{Binding CanRetryElevated}" Click="OnRetryElevated"
                  ToolTip.Tip="Windows asks for approval; the FileCat administrator window then shows the exact steps before they run" />
          <TextBlock Text="{Binding $parent[UserControl].((vm:OperationCenterViewModel)DataContext).Summary}" VerticalAlignment="Center" Classes="small muted" />
          <Button Classes="flat" Content="Details (Ctrl+J)" Click="OnToggleDetails" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Details drawer -->
    <Border IsVisible="{Binding IsOpen}" Height="240" Background="{DynamicResource FcPanel}" BorderBrush="{DynamicResource FcBorder}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="2*,Auto,3*" RowDefinitions="Auto,*">
        <!-- Interrupted jobs -->
        <StackPanel Grid.ColumnSpan="3">
        <ItemsControl ItemsSource="{Binding Interrupted}" Margin="8,4">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:InterruptedJobViewModel">
              <Border Classes="banner" Margin="0,2">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Classes="small warning" />
                    <TextBlock Text="{Binding Details}" Classes="small" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Content="{Binding ContinueLabel}" Tag="{Binding}" Click="OnRunAgainInterrupted" IsVisible="{Binding CanRunAgain}"
                            ToolTip.Tip="Review the original naming, filter and folder layout; existing files are kept under recovery's Skip policy" />
                    <Button Content="Review a new transfer…" Tag="{Binding}" Click="OnReviewNewInterrupted" IsVisible="{Binding CanReviewNewTransfer}"
                            ToolTip.Tip="Original transfer options are incomplete; choose and review a new transfer before anything changes" />
                    <Button Content="{Binding CleanupLabel}" Tag="{Binding}" Click="OnCleanupInterrupted" />
                    <Button Content="Review report" Tag="{Binding}" Click="OnInterruptedReport" AutomationProperties.Name="{Binding ReviewReportLabel}"
                            ToolTip.Tip="Inspect, copy or save all retained known paths and review limits without changing files" />
                    <Button Content="Mark reviewed…" Tag="{Binding}" Click="OnMarkInterruptedReviewed" AutomationProperties.Name="{Binding MarkReviewedLabel}"
                            ToolTip.Tip="Stop future recovery reminders after review; files remain unchanged and a diagnostic report is retained" />
                    <Button Content="Hide for now" Tag="{Binding}" Click="OnHideInterrupted" AutomationProperties.Name="{Binding HideLabel}"
                            ToolTip.Tip="Hide this notice until FileCat restarts; keep the recovery journal and all files unchanged" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="Reviewed recovery reports" Classes="small muted" Margin="10,0,0,2" IsVisible="{Binding HasReviewedRecovery}" />
        <ListBox ItemsSource="{Binding ReviewedRecovery}" MaxHeight="70" IsVisible="{Binding HasReviewedRecovery}" Margin="8,0,8,4" Classes="choices"
                 AutomationProperties.Name="Reviewed recovery reports">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="services:RecoveryReviewRecord">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Display}" Classes="small" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Open recovery report" Tag="{Binding}" Click="OnReviewedRecoveryReport"
                        AutomationProperties.Name="{Binding OpenLabel}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        </StackPanel>

        <DockPanel Grid.Row="1">
          <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" Margin="8,4">
            <TextBlock Text="Operations" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Classes="flat" Content="Clear finished history…" Click="OnClearFinished" IsVisible="{Binding HasFinished}"
                    ToolTip.Tip="Removes finished reports and unused Undo steps from this session; review is required for useful records" />
          </WrapPanel>
          <Panel>
          <!-- Nothing yet: say what will appear here. -->
          <TextBlock Text="No operations yet. Copies, moves, deletions, and other jobs show their progress and reports here."
                     Classes="small muted" TextWrapping="Wrap" Margin="10,6" IsVisible="{Binding !Jobs.Count}" />
          <ListBox ItemsSource="{Binding Jobs}" SelectedItem="{Binding Selected}" Classes="choices"
                   AutomationProperties.Name="Operations history">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:JobViewModel">
                <StackPanel Spacing="1">
                  <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Route}" Classes="small muted" TextTrimming="CharacterEllipsis"
                             IsVisible="{Binding Route, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <TextBlock Classes="small muted" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding StateText}" />
                    <Run Text=" · " />
                    <Run Text="{Binding DetailText}" />
                  </TextBlock>
                  <ProgressBar Height="3" MinHeight="3" Minimum="0" Maximum="100" Value="{Binding Percent}" IsVisible="{Binding IsActive}" IsIndeterminate="{Binding IsIndeterminate}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          </Panel>
        </DockPanel>
        <GridSplitter Grid.Row="1" Grid.Column="1" Width="4" ResizeDirection="Columns" Background="Transparent" />
        <!-- The chosen operation's actions and report; nothing while none is chosen. -->
        <DockPanel Grid.Row="1" Grid.Column="2" DataContext="{Binding Selected}" x:DataType="vm:JobViewModel"
                   IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}">
          <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" Margin="8,4">
            <Button Content="Review decision…" IsVisible="{Binding NeedsDecision}" Click="OnReviewDecision" />
            <Button Content="Pause" IsVisible="{Binding CanPause}" Click="OnPause" />
            <Button Content="{Binding ResumeLabel}" IsVisible="{Binding CanResume}" Click="OnResume" />
            <Button Content="Cancel" IsVisible="{Binding !IsFinished}" Click="OnCancel" />
            <Button Content="Undo" IsVisible="{Binding CanUndo}" Click="OnUndo" />
            <TextBlock Text="{Binding UndoStatus}" VerticalAlignment="Center" Classes="small muted" />
            <Button Content="Undo report" IsVisible="{Binding CanShowUndoReport}" Click="OnShowUndoReport"
                    ToolTip.Tip="Every outcome with full paths and counts; includes Copy all and Save as" />
            <Button Content="Show affected files" IsVisible="{Binding CanShowUndoReport}" Click="OnShowUndoAffected"
                    ToolTip.Tip="Show affected paths that still exist, including a retained original hard-link name" />
            <Button Content="Results" IsVisible="{Binding CanShowResults}" Click="OnShowResults"
                    ToolTip.Tip="What the check found, file by file: each checksum's expected and computed values, and each signature" />
            <Button Content="Retry as administrator…" IsVisible="{Binding CanRetryElevated}" Click="OnRetryElevated"
                    ToolTip.Tip="Windows asks for approval; the FileCat administrator window then shows the exact steps before they run" />
            <Button Content="Move up" Click="OnMoveUp" IsVisible="{Binding !IsActive}" />
            <Button Content="Limit speed…" Click="OnLimit" IsVisible="{Binding !IsFinished}" />
            <Button Content="Remove history row…" IsVisible="{Binding IsFinished}" Click="OnRemove"
                    ToolTip.Tip="Removes this report and its unused Undo steps from this session" />
          </WrapPanel>
          <!-- The chosen operation at a glance (release issue I30): where from and to, what it does now and how far, how long
               it has run and has left, what it did, and its pace. -->
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="10,0,10,6">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding Route}" Classes="small" TextWrapping="Wrap"
                         IsVisible="{Binding Route, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Classes="small" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding PhaseText}" FontWeight="SemiBold" />
                <Run Text="  " />
                <Run Text="{Binding PercentText}" FontWeight="SemiBold" />
              </TextBlock>
              <TextBlock Text="{Binding CurrentFileText}" Classes="small muted" TextTrimming="CharacterEllipsis"
                         IsVisible="{Binding CurrentFileText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Text="{Binding TimingText}" Classes="small" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding ItemsText}" Classes="small" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding DataText}" Classes="small" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding SpeedText}" Classes="small" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="2" Margin="12,2,0,0" IsVisible="{Binding HasSpeedHistory}">
              <controls:SpeedGraph Width="260" Height="64" Values="{Binding SpeedHistory}" ToolTip.Tip="Across: elapsed time, newest at right. Up: copied data and verification reads, or completed items per second. Skipped work is excluded." />
              <TextBlock Text="{Binding GraphCaption}" Classes="small muted" HorizontalAlignment="Right" />
            </StackPanel>
          </Grid>
          <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" ItemSpacing="6" LineSpacing="4" Margin="8,0,8,4">
            <TextBlock Text="{Binding $parent[UserControl].((vm:OperationCenterViewModel)DataContext).IssueSummary}"
                       Classes="small muted" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Content="Issue details…" Click="OnIssueDetails"
                    IsEnabled="{Binding $parent[UserControl].((vm:OperationCenterViewModel)DataContext).SelectedIssue, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <Button Content="Copy report" Click="OnCopyReport" />
            <Button Content="Save report…" Click="OnSaveReport" />
          </WrapPanel>
          <ListBox ItemsSource="{Binding $parent[UserControl].((vm:OperationCenterViewModel)DataContext).SelectedIssues}"
                   SelectedItem="{Binding $parent[UserControl].((vm:OperationCenterViewModel)DataContext).SelectedIssue, Mode=TwoWay}" Classes="choices">
            <AutomationProperties.Name>Selected operation issues</AutomationProperties.Name>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="jobs:JobIssue">
                <StackPanel>
                  <TextBlock TextWrapping="Wrap" Classes="small">
                    <Run Text="{Binding Severity}" FontWeight="SemiBold" />
                    <Run Text=": " />
                    <Run Text="{Binding Message}" />
                  </TextBlock>
                  <TextBlock Text="{Binding Path}" Classes="small muted" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
