<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FileCat.App.ViewModels"
        xmlns:local="using:FileCat.App.Views"
        xmlns:controls="using:FileCat.App.Controls"
        x:Class="FileCat.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="FileCat"
        Width="1280" Height="800" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/filecat.ico">
  <Grid RowDefinitions="Auto,*,Auto,Auto,Auto">
    <!-- Behind everything: quiet circuitry, psychedelic light, or steampunk iron and glass. -->
    <controls:ThemeBackdrop x:Name="Backdrop" Grid.Row="0" Grid.RowSpan="5" />

    <StackPanel Grid.Row="0">
      <Grid x:Name="MenuRow" ColumnDefinitions="Auto,*">
        <Menu x:Name="MainMenu" />
        <!-- Runs any command without walking the menus (plan §4.4); its width follows the room the menus leave. -->
        <TextBox x:Name="CommandSearchBox" Grid.Column="1" Classes="commandSearch" HorizontalAlignment="Right"
                 Margin="8,2,6,2" PlaceholderText="Search commands"
                 AutomationProperties.Name="Search commands" />
      </Grid>
      <!-- Stable primary actions; More retains secondary commands. Classic layout remains an Appearance option. -->
      <Border x:Name="ToolbarRow" Classes="toolbar" IsVisible="{Binding ShowToolbar}">
        <Grid ColumnDefinitions="*,Auto">
          <ScrollViewer x:Name="ToolbarScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <WrapPanel x:Name="Toolbar" />
          </ScrollViewer>
          <Button x:Name="ToolbarMore" Grid.Column="1" Content="More ▾" Margin="4,2,4,2"
                  AutomationProperties.Name="More toolbar commands" />
        </Grid>
      </Border>
    </StackPanel>

    <Grid x:Name="WorkspaceHost" Grid.Row="1" Margin="4,2,4,2">
      <!-- Until the panels are built, right after the first frame: the window is FileCat's at once, in its theme, never a
           blank one while a slow start goes on. The panels replace it. -->
      <StackPanel x:Name="StartupMark" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
        <Image Source="/Assets/filecat.png" Width="72" Height="72" Opacity="0.85" />
        <TextBlock Text="Starting FileCat…" Classes="muted" HorizontalAlignment="Center" />
      </StackPanel>
    </Grid>

    <!-- Where a panel being dragged would go (docking, ADR-18); the same margin as the panels, so the places match. -->
    <Canvas x:Name="DockLayer" Grid.Row="1" Margin="4,2,4,2" IsHitTestVisible="False" IsVisible="False">
      <Border x:Name="DockPreview" Classes="dockPreview">
        <TextBlock x:Name="DockPreviewText" Classes="dockPreview" />
      </Border>
      <!-- Where a tab being dragged would go: the gap between two tabs. -->
      <Border x:Name="TabDropMarker" Classes="tabDropMarker" IsVisible="False" />
    </Canvas>

    <Border x:Name="MaximizedStrip" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Right"
            Classes="notification" Margin="0,4,12,0" IsVisible="False">
      <TextBlock x:Name="MaximizedText" Classes="small" />
    </Border>
    <Border x:Name="ResizeStrip" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center"
            Classes="notification" Margin="12,4" MaxWidth="520" IsHitTestVisible="False" IsVisible="False">
      <TextBlock x:Name="ResizeText" Classes="small" TextWrapping="Wrap"
                 AutomationProperties.LiveSetting="Polite" />
    </Border>

    <local:OperationsView x:Name="OperationsPane" Grid.Row="2" DataContext="{Binding Operations}" />

    <Border Grid.Row="3" Classes="status" IsVisible="{Binding ShowCommandLine}">
      <Grid ColumnDefinitions="Auto,*">
        <TextBlock Text="{Binding Workspace.ActiveTab.ShownPath, StringFormat='{}{0}>'}" VerticalAlignment="Center" Classes="muted"
                   MaxWidth="520" TextTrimming="{x:Static TextTrimming.LeadingCharacterEllipsis}" />
        <TextBox x:Name="CommandLine" Grid.Column="1" Classes="path" Text="{Binding CommandLineText}"
                 PlaceholderText="Command line (Ctrl+E) · Ctrl+Enter inserts the focused name"
                 AutomationProperties.Name="Command line" />
      </Grid>
    </Border>

    <ItemsControl Grid.Row="4" ItemsSource="{Binding KeyBar}" IsVisible="{Binding ShowKeyBar}" Margin="2,2,2,3">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Rows="1" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:KeyBarItem">
          <Button Classes="fkey" IsEnabled="{Binding IsEnabled}" Tag="{Binding CommandId}" Click="OnKeyBarClick"
                  AutomationProperties.Name="{Binding Label}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Classes="fkeynum" Text="{Binding Number}" />
              <TextBlock Classes="fkeylabel" Text="{Binding Label}" />
            </StackPanel>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Border x:Name="NotificationBorder" Grid.Row="1" Classes="notification" Classes.error="{Binding NotificationIsError}"
            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24,0,24,22" MaxWidth="900"
            IsVisible="{Binding Notification, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel Spacing="6">
        <ScrollViewer MaxHeight="160" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <Grid>
            <SelectableTextBlock x:Name="NotificationInfoText" Text="{Binding Notification}" TextWrapping="Wrap"
                                 IsVisible="{Binding NotificationIsInfo}" IsTabStop="False"
                                 AutomationProperties.Name="{Binding NotificationAnnouncement}"
                                 AutomationProperties.LiveSetting="Polite" />
            <SelectableTextBlock x:Name="NotificationErrorText" Text="{Binding Notification}" TextWrapping="Wrap"
                                 IsVisible="{Binding NotificationIsError}" IsTabStop="False"
                                 AutomationProperties.Name="{Binding NotificationAnnouncement}"
                                 AutomationProperties.LiveSetting="Assertive" />
          </Grid>
        </ScrollViewer>
        <TextBlock Classes="small" Text="{Binding NotificationRepeatText}"
                   IsVisible="{Binding NotificationRepeatText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="RestoreWorkspaceNotificationButton" Content="Restore previous workspace"
                  IsVisible="{Binding NotificationRestoreWorkspace}" Click="OnNotificationRestoreWorkspaceClicked" />
          <Button x:Name="NotificationCopyButton" Content="Copy text" Click="OnNotificationCopyClicked" AutomationProperties.Name="Copy notification" />
          <Button x:Name="NotificationHistoryButton" Content="History" Click="OnNotificationHistoryClicked" AutomationProperties.Name="Recent notifications" />
          <Button x:Name="NotificationCloseButton" Content="Dismiss" Click="OnNotificationCloseClicked" AutomationProperties.Name="Dismiss notification" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Panel x:Name="OverlayHost" Grid.Row="0" Grid.RowSpan="5" Panel.ZIndex="1000" IsVisible="False" />
  </Grid>
</Window>
