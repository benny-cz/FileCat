<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FileCat.App.ViewModels"
        xmlns:local="using:FileCat.App.Views"
        xmlns:controls="using:FileCat.App.Controls"
        x:Class="FileCat.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="FileCat"
        Width="1280" Height="800" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/filecat.ico">
  <Grid RowDefinitions="Auto,*,Auto,Auto,Auto">
    <!-- Behind everything: quiet circuitry, psychedelic light, or steampunk iron and glass. -->
    <controls:ThemeBackdrop x:Name="Backdrop" Grid.Row="0" Grid.RowSpan="5" />

    <StackPanel Grid.Row="0">
      <Grid x:Name="MenuRow" ColumnDefinitions="Auto,*">
        <Menu x:Name="MainMenu" />
        <!-- Runs any command without walking the menus (plan §4.4); its width follows the room the menus leave. -->
        <TextBox x:Name="CommandSearchBox" Grid.Column="1" Classes="commandSearch" HorizontalAlignment="Right"
                 Margin="8,2,6,2" PlaceholderText="Search commands"
                 AutomationProperties.Name="Search commands" />
      </Grid>
      <!-- The toolbar (D-49): the commands used most, under the menu as in Salamander; View → Show the toolbar hides it. -->
      <Border x:Name="ToolbarRow" Classes="toolbar" IsVisible="{Binding ShowToolbar}">
        <WrapPanel x:Name="Toolbar" />
      </Border>
    </StackPanel>

    <Grid x:Name="WorkspaceHost" Grid.Row="1" Margin="4,2,4,2">
      <!-- Until the panels are built, right after the first frame: the window is FileCat's at once, in its theme, never a
           blank one while a slow start goes on. The panels replace it. -->
      <StackPanel x:Name="StartupMark" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
        <Image Source="/Assets/filecat.png" Width="72" Height="72" Opacity="0.85" />
        <TextBlock Text="Starting FileCat…" Classes="muted" HorizontalAlignment="Center" />
      </StackPanel>
    </Grid>

    <!-- Over the panels: the psychedelic theme's rare glitches. -->
    <controls:ThemeGlitchOverlay Grid.Row="1" />

    <!-- Where a panel being dragged would go (docking, ADR-18); the same margin as the panels, so the places match. -->
    <Canvas x:Name="DockLayer" Grid.Row="1" Margin="4,2,4,2" IsHitTestVisible="False" IsVisible="False">
      <Border x:Name="DockPreview" Classes="dockPreview">
        <TextBlock x:Name="DockPreviewText" Classes="dockPreview" />
      </Border>
    </Canvas>

    <Border x:Name="MaximizedStrip" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Right"
            Classes="notification" Margin="0,4,12,0" IsVisible="False">
      <TextBlock x:Name="MaximizedText" Classes="small" />
    </Border>

    <local:OperationsView x:Name="OperationsPane" Grid.Row="2" DataContext="{Binding Operations}" />

    <Border Grid.Row="3" Classes="status" IsVisible="{Binding ShowCommandLine}">
      <Grid ColumnDefinitions="Auto,*">
        <TextBlock Text="{Binding Workspace.ActiveTab.DisplayPath, StringFormat='{}{0}>'}" VerticalAlignment="Center" Classes="muted"
                   MaxWidth="520" TextTrimming="{x:Static TextTrimming.LeadingCharacterEllipsis}" />
        <TextBox x:Name="CommandLine" Grid.Column="1" Classes="path" Text="{Binding CommandLineText}"
                 PlaceholderText="Command line (Ctrl+E) · Ctrl+Enter inserts the focused name"
                 AutomationProperties.Name="Command line" />
      </Grid>
    </Border>

    <ItemsControl Grid.Row="4" ItemsSource="{Binding KeyBar}" IsVisible="{Binding ShowKeyBar}" Margin="2,2,2,3">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Rows="1" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:KeyBarItem">
          <Button Classes="fkey" IsEnabled="{Binding IsEnabled}" Tag="{Binding CommandId}" Click="OnKeyBarClick"
                  AutomationProperties.Name="{Binding Label}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Classes="fkeynum" Text="{Binding Number}" />
              <TextBlock Classes="fkeylabel" Text="{Binding Label}" />
            </StackPanel>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Border x:Name="NotificationBorder" Grid.Row="1" Classes="notification" Classes.error="{Binding NotificationIsError}"
            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24,0,24,22" MaxWidth="900"
            IsVisible="{Binding Notification, Converter={x:Static ObjectConverters.IsNotNull}}"
            PointerPressed="OnNotificationPressed">
      <TextBlock Text="{Binding Notification}" TextWrapping="Wrap" />
    </Border>

    <Panel x:Name="OverlayHost" Grid.Row="0" Grid.RowSpan="5" IsVisible="False" />
  </Grid>
</Window>
