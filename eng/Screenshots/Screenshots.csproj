<Project Sdk="Microsoft.NET.Sdk">
  <!-- Development tool: renders FileCat's main window off-screen (Avalonia headless, Skia) to PNG files for visual
       checks of icons and themes; no window opens on the desktop. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/FileCat.App/FileCat.App.csproj" />
    <PackageReference Include="Avalonia.Headless" />
  </ItemGroup>
</Project>
