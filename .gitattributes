* text=auto
*.cs text eol=crlf diff=csharp
*.axaml text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf
*.md text eol=lf
*.sh text eol=lf
*.png binary
*.ico binary
*.zip binary

# Preserve the exact upstream license bytes in installer source/evidence.
eng/installer/licenses/InnoSetup-6.7.1.txt -text
# Frozen notice/snapshot bytes retain original line endings and whitespace.
licenses/dependencies/** -text -whitespace
licenses/appimage-runtime/** -text -whitespace

# Retained publish metadata keeps its exact producer bytes.
eng/validation/fixtures/dependency-notices/** -text
# Original generated manifest CRLF is part of the pinned fixture bytes.
eng/validation/fixtures/dependency-notices/*/FileCat.deps.json -whitespace
