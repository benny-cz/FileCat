{
  "name": "1.0 release branch: PR and five CI checks",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/release/1.0"],
      "exclude": []
    }
  },
  "rules": [
    {"type": "deletion"},
    {"type": "non_fast_forward"},
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": ["merge"]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          {"context": "Producer reference policy (stable blocked)", "integration_id": 15368},
          {"context": "Windows (build, all tests)", "integration_id": 15368},
          {"context": "Windows ARM64 (build, tests, package start)", "integration_id": 15368},
          {"context": "ubuntu-24.04 (build, portable tests)", "integration_id": 15368},
          {"context": "macos-26 (build, portable tests)", "integration_id": 15368}
        ]
      }
    }
  ]
}
