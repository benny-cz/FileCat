    <UnitTestResult testName="FileCat.Platform.Windows.Tests.WindowsEfsJobTests.A_file_whose_only_key_names_a_smart_card_is_asked_about_before_Windows_waits_for_a_reader" outcome="Passed" testType="13cdc9d9-ddb5-4fa4-a97d-d965ccfc6d4b" testListId="8c84fa94-04c1-424b-9868-57a2d4851a1d" testId="96fb6f61-58fe-4bda-a490-8572d4f7ed00" executionId="96fb6f61-58fe-4bda-a490-8572d4f7ed00" computerName="DESKTOP-A60F1NE" duration="00:00:00.2382289" startTime="2026-11-22T13:29:24.1982886+00:00" endTime="2026-11-22T13:29:24.4365810+00:00">
      <Output>
        <TextMessages>
          <Message>EFS_SMART_CARD step=card-only-users finished=True seconds=0,0</Message>
          <Message>EFS_SMART_CARD step=card-only-key finished=True seconds=0,0</Message>
          <Message>EFS_SMART_CARD phase=card-only-key certificate=B9007ED529620A44E8C99F03D6F4891D27564EA5 state=Unavailable provider=Capi error=0x80090016 problem=efs-private-key backup=none</Message>
          <Message>EFS_SMART_CARD phase=card-only-decrypt job=CompletedWithIssues asked=1 asked-after=0,1 total=0,1 changed=0 skipped=1 reasons=efs-key-skipped</Message>
          <Message>EFS_SMART_CARD question Windows needs the EFS key of certificate Admin(Admin@DESKTOP-A60F1NE) (B9007ED5…) to decrypt card-only.txt, and FileCat could not reach that key without asking: its key is on a smart card or security key that is not available now. If the key is on a smart card or security key, connect it and choose Retry. Decrypt anyway lets Windows wait for the key, which can take several minutes and may still fail. Skip leaves this file encrypted.</Message>
        </TextMessages>
      </Output>
    </UnitTestResult>
