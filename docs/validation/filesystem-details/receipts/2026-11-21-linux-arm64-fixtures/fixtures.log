uname -a
ldd --version | head -n 1
truncate -s 64M "$RUNNER_TEMP/inline.img"
mkfs.ext4 -q -F -O inline_data "$RUNNER_TEMP/inline.img"
sudo mkdir -p /mnt/fc-inline
sudo mount -o loop "$RUNNER_TEMP/inline.img" /mnt/fc-inline
sudo chown "$(id -u):$(id -g)" /mnt/fc-inline
echo probe > /mnt/fc-inline/probe
lsattr /mnt/fc-inline/probe
rm /mnt/fc-inline/probe
